# Optional. Without a key the AI Field Agent runs in a clearly labeled demo mode.
# Copy this file to .env.local and fill in the key. Never commit .env.local.
ANTHROPIC_API_KEY=

# Optional model override for the Field Agent.
AGENT_MODEL=claude-sonnet-5-5

# Optional: set to "false" to disable the live Open-Meteo weather lookup (falls back to sample weather).
LIVE_WEATHER=true
